---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import Services from '../components/Services.astro';
import { t, path, ui, ageOn, fmtYear } from '../data/i18n.js';
import { person, highlights, brands } from '../data/profile.js';
import { works, categories } from '../data/works.js';
import { portrait, film, srcset } from '../data/img.js';
const { lang } = Astro.props;
// รูปสไลด์หน้าแรก (เลขตามลำดับใน images.json)
const heroSlides = [1, 2, 4, 16].map(portrait);
const about = portrait(2);
const featured = works.filter((w) => w.featured).sort((a, b) => a.featured - b.featured);
const age = ageOn(person.birthDate);
const strip = [film[10], film[0], film[18], film[8], film[13], film[2], film[19], film[16], film[6]].filter(Boolean);
const chev = (d) => `<svg viewBox="0 0 24 24"><path d="${d}"/></svg>`;
---
<Layout lang={lang} page="home">
  <section class="hero">
    <div class="hero__media" data-slideshow data-interval="5500">
      {heroSlides.map((im, i) => (
        <img class={`slide${i === 0 ? ' is-active' : ''}`} src={i === 0 ? im.lg : im.sm} srcset={srcset(im)} sizes="(max-width: 700px) 100vw, 58vw"
          alt={i === 0 ? person.nameEn : ''} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" width={im.w} height={im.h} />
      ))}
    </div>
    <div class="wrap hero__content">
      <span class="eyebrow">Portfolio · {new Date().getFullYear()}</span>
      <a class="avail" href="#services"><i></i>{t(ui.available, lang)}</a>
      <h1 class="h-display hero__name">
        <span class="line"><span><em class="gold">Ken</em> Suthat</span></span>
        <span class="line"><span>Thongkaemkaew</span></span>
      </h1>
      <p class="hero__th reveal" style="--d:.5s">{person.nameTh} ({t(person.nick, 'th')})</p>
      <ul class="hero__roles reveal" style="--d:.6s">
        {t(person.roles, lang).map((r) => <li>{r}</li>)}
      </ul>
      <div class="hero__cta reveal" style="--d:.7s">
        <a class="btn" href="#works">{t(ui.viewWorks, lang)}</a>
        <a class="btn btn--ghost" href="#contact">{t(ui.contactMe, lang)}</a>
      </div>
    </div>
    <div class="slide-dots" aria-hidden="true">
      {heroSlides.map((_, i) => <span class={i === 0 ? 'is-active' : ''}></span>)}
    </div>
  </section>

  {person.showreel && (
    <section class="section" style="padding-top:40px">
      <div class="wrap">
        <span class="eyebrow reveal">Showreel</span>
        <div class="showreel reveal" style="margin-top:24px"><Media m={person.showreel} lang={lang} brand="Showreel" /></div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <div class="stats">
        {highlights.map((h, i) => (
          <div class="stat reveal" style={`--d:${i * 0.08}s`}>
            <div class="stat__value">{h.prefix && <small style="margin:0 2px 0 0">{h.prefix}</small>}{h.value}{h.suffix && <small>{h.suffix}</small>}</div>
            <div class="stat__label">{t(h.label, lang)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="marquee" aria-label={t(ui.brandsTitle, lang)}>
    <div class="marquee__track">
      {[...brands, ...brands].map((b, i) => <span class="marquee__item" aria-hidden={i >= brands.length ? 'true' : undefined}>{b}</span>)}
    </div>
  </div>

  <section class="section" id="works">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow reveal">{t(ui.selected, lang)}</span>
          <h2 class="h-section reveal" style="--d:.08s">{lang === 'th' ? 'ผลงานที่ภาคภูมิใจ' : 'Work I’m proud of'}</h2>
          <p class="lead reveal" style="--d:.12s;margin-top:14px">{t(ui.carouselHint, lang)}</p>
        </div>
        <div class="carousel-nav reveal">
          <button class="lb-btn" type="button" data-car-prev aria-label={t(ui.prev, lang)} set:html={chev('M15 6l-6 6 6 6')} />
          <button class="lb-btn" type="button" data-car-next aria-label={t(ui.next, lang)} set:html={chev('M9 6l6 6-6 6')} />
        </div>
      </div>
      <div class="carousel" data-carousel>
        {featured.map((w, i) => {
          const cat = categories.find((c) => c.id === w.category);
          const m = (w.media ?? [])[0];
          return (
            <article class="wcard reveal" style={`--d:${Math.min(i, 3) * 0.08}s`}>
              {m && <Media m={m} lang={lang} brand={t(w.brand, lang)} card />}
              <div class="wcard__body">
                <div class="work__meta"><span>{t(cat, lang)}</span>{w.year && <span class="yr">{fmtYear(w.year, lang)}</span>}</div>
                <h3 class="wcard__brand">{t(w.brand, lang)}</h3>
                <p class="wcard__title">{t(w.title, lang)}</p>
                {w.desc && <p class="wcard__desc">{t(w.desc, lang)}</p>}
                <a class="link-arrow" href={path('/works/', lang) + '#' + w.slug}>{t(ui.details, lang)} →</a>
              </div>
            </article>
          );
        })}
        <a class="wcard wcard--more reveal" href={path('/works/', lang)}>
          <span class="eyebrow">{t(ui.worksTitle, lang)}</span>
          <span class="wcard__more">{t(ui.allWorks, lang)} →</span>
          <span class="muted">{works.length} {lang === 'th' ? 'ผลงาน' : 'projects'}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="frame reveal-img">
        <img src={about.sm} srcset={srcset(about)} sizes="(max-width: 860px) 90vw, 440px" alt={person.nameEn} loading="lazy" width={about.w} height={about.h} />
      </div>
      <div class="about__text">
        <span class="eyebrow reveal">{t(ui.about, lang)}</span>
        <h2 class="h-quote reveal" style="--d:.08s">{t(person.intro, lang)}</h2>
        <p class="reveal" style="--d:.16s">{t(person.about, lang)[1]}</p>
        <dl class="facts reveal" style="--d:.24s">
          <div><dt>{t(ui.age, lang)}</dt><dd data-age={person.birthDate}>{age}</dd></div>
          <div><dt>{t(ui.height, lang)}</dt><dd>{person.stats.heightCm} cm</dd></div>
          <div><dt>{t(ui.shoe, lang)}</dt><dd>EU 44.5</dd></div>
        </dl>
        <p class="reveal" style="--d:.3s;margin-top:34px"><a class="link-arrow" href={path('/profile/', lang)}>{t(ui.readProfile, lang)} →</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow reveal">{t(ui.hobbies, lang)}</span>
          <h2 class="h-section reveal" style="--d:.08s"><span class="italic">{t(ui.galleryTeaser, lang)}</span></h2>
          <p class="lead reveal" style="--d:.14s;margin-top:16px">{t(ui.galleryTeaserText, lang)}</p>
        </div>
        <a class="link-arrow reveal" href={path('/gallery/', lang) + '#film'}>{t(ui.openGallery, lang)} →</a>
      </div>
      <div class="strip reveal">
        {strip.map((f) => (
          <a href={path('/gallery/', lang) + '#film'} aria-label={`${f.camera} · ${f.stock}`}>
            <img src={f.sm} alt={`${f.camera} · ${f.stock}`} loading="lazy" decoding="async" width={f.w} height={f.h} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <Services lang={lang} />
</Layout>
