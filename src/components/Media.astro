---
// One media item: TikTok / YouTube / Instagram (click-to-load) or a photo
import { t, ui } from '../data/i18n.js';
import { workImg, srcset } from '../data/img.js';
const { m, lang, brand = '', card = false } = Astro.props;

const play = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"/></svg>`;
let cfg = null;
if (m.type === 'tiktok') {
  cfg = {
    cls: 'embed--v', platform: 'TikTok',
    src: `https://www.tiktok.com/player/v1/${m.id}?autoplay=1&description=0&music_info=0&rel=0`,
    ext: `https://www.tiktok.com/@${m.user}/video/${m.id}`,
  };
} else if (m.type === 'youtube') {
  cfg = {
    cls: 'embed--h', platform: 'YouTube',
    src: `https://www.youtube-nocookie.com/embed/${m.id}?autoplay=1&rel=0`,
    ext: `https://www.youtube.com/watch?v=${m.id}`,
    poster: `https://i.ytimg.com/vi/${m.id}/hqdefault.jpg`,
  };
} else if (m.type === 'instagram') {
  cfg = {
    cls: 'embed--ig', platform: 'Instagram',
    src: `https://www.instagram.com/reel/${m.id}/embed/`,
    ext: `https://www.instagram.com/reel/${m.id}/`,
  };
}
const label = t(m.label, lang) || brand;
const im = m.type === 'image' ? workImg(m.src) : null;
---
{cfg && (
  <div class={`embed ${card ? 'embed--card' : cfg.cls}`}>
    <button class="embed__poster" type="button" data-embed={cfg.src} data-title={`${cfg.platform} — ${label}`} aria-label={`${t(ui.play, lang)}: ${label}`}>
      {cfg.poster && <img src={cfg.poster} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
      <span class="embed__platform">{cfg.platform}</span>
      <span class="embed__play" set:html={play} />
      <span class="embed__label">{label}</span>
    </button>
    <a class="embed__ext" href={cfg.ext} target="_blank" rel="noopener" aria-label={`${t(ui.watchOn, lang)} ${cfg.platform}`}>↗</a>
  </div>
)}
{im && (
  <figure class={`photo${card ? ' photo--card' : ''}`} style="margin:0">
    <img src={im.sm} srcset={srcset(im)} sizes={card ? "320px" : "(max-width: 860px) 100vw, 600px"} alt={label} loading="lazy" decoding="async" width={im.w} height={im.h} />
    {m.label && <figcaption>{t(m.label, lang)}</figcaption>}
  </figure>
)}
